# DocFlow AI Website — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Resend (contact form email delivery) ──────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ── Sender address (must be a verified domain in Resend) ──────────────────
# Until docflowai.com.au is verified, use onboarding@resend.dev (Resend's test sender)
# Once domain is verified: DocFlow AI Contact <noreply@docflowai.com.au>
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Contact email (where form submissions are sent) ───────────────────────
CONTACT_EMAIL=siddhesh.automate@gmail.com

# ── Calendly (booking calendar embed) ────────────────────────────────────
# Your Calendly booking link, e.g. https://calendly.com/your-username/10min
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/siddhesh-automate/30min
