# DocFlow AI Website — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Resend (contact form email delivery) ──────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ── Contact email (where form submissions are sent) ───────────────────────
CONTACT_EMAIL=sid@docflowai.com.au

# ── Calendly (booking calendar embed) ────────────────────────────────────
# Your Calendly booking link, e.g. https://calendly.com/your-username/10min
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/10min
